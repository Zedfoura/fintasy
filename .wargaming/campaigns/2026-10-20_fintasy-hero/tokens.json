    "wordmarkSup": { "family": "display", "size": "10px", "weight": 400, "letterSpacing": "0.1em", "color": "mute" },
    "body": { "family": "mono", "size": "14px", "weight": 400, "lineHeight": 1.6, "maxWidth": "40ch", "color": "body" },
    "nav": { "family": "mono", "size": "13px", "weight": 400, "letterSpacing": "0.02em" },
    "cta": { "family": "mono", "size": "14px", "weight": 500 },
    "caption": { "family": "mono", "size": "12px", "weight": 400, "lineHeight": 1.5, "letterSpacing": "0.02em" },
