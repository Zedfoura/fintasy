    { "name": "caption over storm", "fg": "bone", "bg": "#29253F", "min": 4.5, "$comment": "bone over storm tint flattened onto ink" }
  ],
  "font": {
    "display": { "family": "Archivo", "source": "Google Fonts, axes wdth 62..125, wght 100..900" },
