  "contrast": [
    { "name": "headline/wordmark", "fg": "bone", "bg": "ink", "min": 4.5 },
    { "name": "body paragraph", "fg": "body", "bg": "ink", "min": 4.5 },
    { "name": "captions/meta", "fg": "mute", "bg": "ink", "min": 4.5 },
    { "name": "alive counter / hover", "fg": "violet", "bg": "ink", "min": 4.5 },
