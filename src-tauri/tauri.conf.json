{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/tooling/cli/schema.json",
  "productName": "Fintasy: Stock Royale",
  "version": "0.1.0",
  "identifier": "com.fintasy.stockroyale",
  "build": {
    "beforeDevCommand": "pnpm dev:client",
    "beforeBuildCommand": "pnpm --filter client build",
    "devUrl": "http://localhost:3333",
    "frontendDist": "../packages/client/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fintasy: Stock Royale",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
